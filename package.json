{
  "name": "opencode-dcp",
  "version": "2.0.0-beta.12",
  "description": "Dynamic Context Pruning (DCP) plugin for OpenCode V2 - model-driven context compression, tool-output pruning, and context-window nudges",
  "keywords": [
    "context-compression",
    "context-window",
    "dcp",
    "dynamic-context-pruning",
    "llm",
    "opencode",
    "opencode-plugin"
  ],
  "homepage": "https://github.com/arafays/opencode-dcp#readme",
  "bugs": {
    "url": "https://github.com/arafays/opencode-dcp/issues"
  },
  "license": "MIT",
  "author": "Abdul Rafay Shaikh <me@arafays.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafays/opencode-dcp.git"
  },
  "files": [
    "dist",
    "tui.tsx",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": "./tui.tsx"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-tui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "latest",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@opencode/theme": "latest",
    "@types/node": "24.12.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.8.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "aube": {
    "allowBuilds": {
      "protobufjs": true
    }
  }
}
