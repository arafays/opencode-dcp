{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "../dist",
      "options": {
        "debug": true,
        "maxContextLimit": 120000,
        "strategies": {
          "deduplication": {
            "enabled": true
          },
          "purgeErrors": {
            "enabled": true,
            "turns": 4
          }
        }
      }
    }
  ],
  "lsp": true,
  "references": {
    "opencode-v2": {
      "repository": "anomalyco/opencode",
      "branch": "v2",
      "description": "OpenCode V2 source code on the v2 branch: use for implementation details of server, plugins, and config"
    }
  }
}
